<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="bi bi-receipt me-2"></i>Pedidos</h2>
    <small class="text-muted"><%= pedidos.length %> registros encontrados</small>
  </div>
  <a href="/pedidos/nuevo" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>Nuevo Pedido
  </a>
</div>

<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-table"></i> Lista de Pedidos
  </div>
  <div class="card-body p-0">
    <% if (pedidos.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">No hay pedidos registrados aún.</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Total (S/.)</th>
            <th class="text-center">Comprobante</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% pedidos.forEach(p => { %>
          <tr>
            <td><span class="badge bg-secondary"><%= p._id %></span></td>
            <td><%= new Date(p.fecha).toLocaleDateString('es-PE') %></td>
            <td>
              <span class="badge-cliente">
                <i class="bi bi-person me-1"></i><%= p.id_cliente.nombre %>
              </span>
            </td>
            <td class="fw-bold text-success">S/. <%= parseFloat(p.total).toFixed(2) %></td>
            <td class="text-center">
              <% if (p.comprobante_img) { %>
                <% const ext = p.comprobante_img.split('.').pop().toLowerCase(); %>
                <% if (ext === 'pdf') { %>
                  <a href="/uploads/<%= p.comprobante_img %>" target="_blank" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-file-pdf"></i> Ver PDF
                  </a>
                <% } else { %>
                  <img src="/uploads/<%= p.comprobante_img %>" class="thumb" alt="comprobante" title="Clic para ampliar"/>
                <% } %>
              <% } else { %>
                <span class="text-muted small"><i class="bi bi-dash-circle"></i> Sin imagen</span>
              <% } %>
            </td>
            <td class="text-center">
              <a href="/pedidos/<%= p._id %>/editar" class="btn btn-sm btn-warning me-1">
                <i class="bi bi-pencil"></i> Editar
              </a>
              <form action="/pedidos/<%= p._id %>?_method=DELETE" method="POST" class="d-inline"
                onsubmit="return confirm('¿Eliminar pedido #<%= p._id %>?')">
                <button class="btn btn-sm btn-danger">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
