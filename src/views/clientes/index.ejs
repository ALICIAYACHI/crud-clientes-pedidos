<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Clientes</h2>
    <small class="text-muted"><%= clientes.length %> registros encontrados</small>
  </div>
  <a href="/clientes/nuevo" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>Nuevo Cliente
  </a>
</div>

<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-table"></i> Lista de Clientes
  </div>
  <div class="card-body p-0">
    <% if (clientes.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">No hay clientes registrados aún.</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% clientes.forEach(c => { %>
          <tr>
            <td><span class="badge bg-secondary"><%= c._id %></span></td>
            <td class="fw-semibold"><%= c.nombre %></td>
            <td><i class="bi bi-telephone me-1 text-muted"></i><%= c.telefono %></td>
            <td><i class="bi bi-envelope me-1 text-muted"></i><%= c.email %></td>
            <td class="text-center">
              <a href="/clientes/<%= c._id %>/editar" class="btn btn-sm btn-warning me-1">
                <i class="bi bi-pencil"></i> Editar
              </a>
              <form action="/clientes/<%= c._id %>?_method=DELETE" method="POST" class="d-inline"
                onsubmit="return confirm('¿Eliminar cliente <%= c.nombre %>? Se borrarán sus pedidos.')">
                <button class="btn btn-sm btn-danger">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
