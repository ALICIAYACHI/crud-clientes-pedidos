<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= titulo %> — GestorPedidos</title>

  <!-- Bootstrap 5 -->
  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <!-- Bootstrap Icons -->
  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

  <style>
    :root {
      --color-primary:  #1a1f3c;
      --color-accent:   #e84393;
      --color-accent2:  #00d4c8;
      --color-bg:       #f4f6fb;
    }
    body { background: var(--color-bg); font-family: 'Segoe UI', sans-serif; }

    /* Navbar */
    .navbar { background: var(--color-primary); }
    .navbar-brand { font-weight: 800; letter-spacing: 1px; color: #fff !important; }
    .navbar-brand span { color: var(--color-accent); }
    .nav-link { color: rgba(255,255,255,.8) !important; font-weight: 500; }
    .nav-link:hover, .nav-link.active { color: var(--color-accent) !important; }

    /* Cards */
    .card { border: none; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.06); }
    .card-header { border-radius: 14px 14px 0 0 !important; background: var(--color-primary); color:#fff; }

    /* Botones */
    .btn-primary   { background: var(--color-accent);  border-color: var(--color-accent); }
    .btn-primary:hover { background: #c0357a; border-color: #c0357a; }
    .btn-info      { background: var(--color-accent2); border-color: var(--color-accent2); color:#fff; }

    /* Badge */
    .badge-cliente { background: #e8f4f8; color: #1a1f3c; font-weight: 600; padding: 4px 10px; border-radius: 20px; font-size:.8rem; }

    /* Imagen comprobante miniatura */
    .thumb { width:56px; height:56px; object-fit:cover; border-radius:8px; border:2px solid #dee2e6; cursor:pointer; transition: transform .2s; }
    .thumb:hover { transform:scale(1.1); }

    /* ── Sticky footer ────────────────────────────────── */
    html, body { height: 100%; }
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    main { flex: 1 0 auto; }
    footer {
      flex-shrink: 0;
      background: var(--color-primary);
      color: rgba(255,255,255,.6);
      font-size: .85rem;
      padding: .9rem 0;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="bi bi-box-seam me-2"></i>Gestor<span>Pedidos</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto gap-1">
        <li class="nav-item">
          <a class="nav-link <%= titulo.includes('Cliente') ? 'active' : '' %>" href="/clientes">
            <i class="bi bi-people me-1"></i>Clientes
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= titulo.includes('Pedido') ? 'active' : '' %>" href="/pedidos">
            <i class="bi bi-receipt me-1"></i>Pedidos
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main class="container py-4">